# Optional overrides (all have sensible defaults):
# SIM_SEED=42
# N_CONTAINERS=150
# SIM_SPEED=60        # sim-seconds per real second; 0 = frozen/deterministic
# PSA_PORT=8513
# PSA_HOST=0.0.0.0

# --- Agentic AI API (the seam) ---------------------------------------------------
# The agent brain is swappable. Leave AGENTIC_API_ENDPOINT unset to run the
# deterministic rule-based planner (zero API, reproducible demos). Set it to an
# OpenAI-compatible agentic endpoint to switch the runtime to the external
# agentic AI API -- the same tool registry drives both brains.
#
# AGENTIC_API_ENDPOINT=https://your-agentic-api.example.com/v1/chat/completions
# AGENTIC_API_KEY=sk-...
# AGENTIC_API_MODEL=gpt-5-mini
#
# Autonomy level: advisory | semi_autonomous | autonomous
# AGENTIC_AUTONOMY=advisory
# AGENTIC_MAX_TOOL_ITERATIONS=20
